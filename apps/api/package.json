{
  "name": "@liam-frost/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "auth:hash": "tsx src/auth/hash-password.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate && npm run db:seed",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:collection": "tsx src/db/seed-collection.ts",
    "db:studio": "prisma studio",
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc --noEmit && node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.1.6",
    "@liam-frost/content": "^0.1.0",
    "@liam-frost/shared": "^0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^16.6.1",
    "exif-reader": "^2.0.3",
    "fastify": "^5.0.0",
    "prisma": "7.10.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.27.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5"
  }
}
