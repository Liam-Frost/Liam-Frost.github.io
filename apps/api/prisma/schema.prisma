generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PUBLIC  @map("public")
  PRIVATE @map("private")
}

/// Where a photo's image files live.
enum ImageStorage {
  /// `src` is an external URL (existing Flickr photos).
  REMOTE_URL @map("remote-url")
  /// Files under UPLOAD_DIR at `storageKey`, served from /uploads.
  LOCAL      @map("local")
}

model Photo {
  id          String       @id
  slug        String       @unique
  title       Json
  date        String
  category    Json
  location    Json?
  camera      String?
  lens        String?
  settings    String?
  description Json?
  tags        Json
  /// External URL for REMOTE_URL photos; empty for uploaded photos (URLs come from storageKey + variants).
  src         String
  storage     ImageStorage @default(REMOTE_URL)
  /// Folder of the uploaded files, e.g. "photos/<id>".
  storageKey  String?
  /// Generated WebP sizes for uploaded photos: [{ "width": 640, "height": 427 }, ...], smallest first.
  variants    Json?
  alt         Json
  width       Int
  height      Int
  featured    Boolean      @default(false)
  visibility  Visibility   @default(PUBLIC)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([visibility, sortOrder])
  @@index([date])
}

enum ProjectStatus {
  IN_PROGRESS @map("in-progress")
  COMPLETED   @map("completed")
  ARCHIVED    @map("archived")
}

model Project {
  id         String        @id
  /// URL segment on the public site (/projects/<slug>); editable, unlike id.
  slug       String        @unique
  title      Json
  /// One-line summary per language.
  summary    Json
  /// Markdown per language.
  body       Json
  /// Uploaded cover image: { id, key, width, height, variants: [{ width, height }] }.
  cover      Json?
  /// Uploaded screenshots, same shape as cover, in display order.
  gallery    Json
  /// Technology names, e.g. ["React", "Fastify"].
  techStack  Json
  /// { repo?, demo?, docs? } URLs.
  links      Json
  status     ProjectStatus @default(IN_PROGRESS)
  /// YYYY-MM
  startedAt  String?
  /// YYYY-MM
  endedAt    String?
  featured   Boolean       @default(false)
  visibility Visibility    @default(PRIVATE)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([visibility, sortOrder])
}

/// Site-wide settings as validated JSON documents, one row per key (e.g. "spotify").
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
