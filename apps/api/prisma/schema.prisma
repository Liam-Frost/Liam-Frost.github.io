generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PUBLIC  @map("public")
  PRIVATE @map("private")
}

/// Where a photo's image files live.
enum ImageStorage {
  /// `src` is an external URL (existing Flickr photos).
  REMOTE_URL @map("remote-url")
  /// Files under UPLOAD_DIR at `storageKey`, served from /uploads.
  LOCAL      @map("local")
}

model Photo {
  id          String       @id
  slug        String       @unique
  title       Json
  date        String
  category    Json
  location    Json?
  camera      String?
  lens        String?
  settings    String?
  description Json?
  tags        Json
  /// External URL for REMOTE_URL photos; empty for uploaded photos (URLs come from storageKey + variants).
  src         String
  storage     ImageStorage @default(REMOTE_URL)
  /// Folder of the site-hosted files: "photos/<id>/<imageId>" (older photos: "photos/<id>").
  storageKey  String?
  /// Generated WebP sizes for uploaded photos: [{ "width": 640, "height": 427 }, ...], smallest first.
  variants    Json?
  /// Where the image came from: { "type": "upload" | "server" | "gallery" | "url", "provider", "ref", "importedAt" }.
  source      Json?
  alt         Json
  width       Int
  height      Int
  featured    Boolean      @default(false)
  visibility  Visibility   @default(PUBLIC)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  /// The version whose image the fields above (src, storage, storageKey, variants, source, width,
  /// height) are a copy of; null until the photo has versions.
  currentVersionId String?
  /// When the photo was moved to the trash; null while it is in use.
  deletedAt   DateTime?
  versions    PhotoVersion[]

  @@index([visibility, sortOrder])
  @@index([date])
  @@index([deletedAt])
}

/// One image of a photo: a different quality, format or source of the same picture. The photo shows its
/// current version; the others are kept for switching back and are only served to the admin.
model PhotoVersion {
  id         String       @id
  photoId    String
  /// The admin's name for it, e.g. "JPEG preview"; may be empty.
  label      String       @default("")
  /// External URL for REMOTE_URL versions; empty for site-hosted ones.
  src        String
  storage    ImageStorage
  storageKey String?      @unique
  variants   Json?
  source     Json?
  width      Int
  height     Int
  createdAt  DateTime     @default(now())
  /// When this version alone was moved to the trash; null while it is in use.
  deletedAt  DateTime?
  photo      Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@index([deletedAt])
}

enum ProjectStatus {
  IN_PROGRESS @map("in-progress")
  COMPLETED   @map("completed")
  ARCHIVED    @map("archived")
}

model Project {
  id         String        @id
  /// URL segment on the public site (/projects/<slug>); editable, unlike id.
  slug       String        @unique
  title      Json
  /// One-line summary per language.
  summary    Json
  /// Markdown per language.
  body       Json
  /// Uploaded cover image: { id, key, width, height, variants: [{ width, height }] }.
  cover      Json?
  /// Uploaded screenshots, same shape as cover, in display order.
  gallery    Json
  /// Technologies that are not in the tech stack, as plain names (e.g. ["Fastify"]); the ones in the
  /// stack are linked through ProjectTechnology.
  techStack  Json
  technologies ProjectTechnology[]
  /// { repo?, demo?, docs? } URLs.
  links      Json
  status     ProjectStatus @default(IN_PROGRESS)
  /// YYYY-MM
  startedAt  String?
  /// YYYY-MM
  endedAt    String?
  featured   Boolean       @default(false)
  visibility Visibility    @default(PRIVATE)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([visibility, sortOrder])
}

/// Site-wide settings as validated JSON documents, one row per key (e.g. "spotify").
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum MediaKind {
  MOVIE @map("movie")
  TV    @map("tv")
  ANIME @map("anime")
  TRACK @map("track")
  ALBUM @map("album")
  BOOK  @map("book")
  COMIC @map("comic")
  GAME  @map("game")
}

enum MediaStatus {
  WANT     @map("want")
  WATCHING @map("watching")
  DONE     @map("done")
  DROPPED  @map("dropped")
}

/// A collection entry: film, series, anime, or (later) a track or album.
model MediaItem {
  id            String       @id
  kind          MediaKind
  /// tmdb, bangumi, spotify, itunes or manual.
  source        String
  /// The entry's id at the source (TMDB ids are prefixed "movie:" / "tv:").
  sourceId      String?
  sourceUrl     String?
  title         Json
  originalTitle String?
  year          Int?
  /// Localized genre names: [{ "zh": "剧情", "en": "Drama" }, ...]
  genres        Json
  /// Directors, studios, creators.
  credits       Json
  overview      Json
  /// Local poster: { id, key, width, height, variants }, like project covers.
  poster        Json?
  /// Films, series, anime, books, comics and games; null for music.
  status        MediaStatus?
  /// 1-5
  rating        Int?
  review        Json
  /// YYYY-MM-DD
  watchedOn     String?
  rewatchCount  Int          @default(0)
  /// { watched, total }: episodes, a comic's volumes or a book's pages.
  progress      Json?
  /// Kind-specific data; music: { album, durationMs, previewUrl, spotifyUrl, appleUrl };
  /// books and comics: publication: { publisher, pages, volumes, ongoing };
  /// games: game: { platforms, publishers, playtimeHours }.
  extra         Json
  /// Music: plays in the site's player.
  inPlayer      Boolean      @default(false)
  featured      Boolean      @default(false)
  /// Position among home-page featured entries in the fixed order; null when never ordered.
  featuredOrder Int?
  visibility    Visibility   @default(PUBLIC)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  relationsFrom MediaRelation[] @relation("RelationFromMedia")
  relationsTo   MediaRelation[] @relation("RelationToMedia")
  playlists     PlaylistTrack[]

  @@unique([source, sourceId])
  @@index([kind, visibility])
}

/// A person or group linked to collection entries: actors, directors, singers, writers, studios.
model Person {
  kind String @default("person")
  aliases Json @default("[]")
  identities PersonIdentity[]
  members PersonMembership[] @relation("GroupMembers")
  memberOf PersonMembership[] @relation("MemberGroups")
  id           String          @id
  /// tmdb or manual.
  source       String
  sourceId     String?
  sourceUrl    String?
  name         Json
  originalName String?
  /// Local photo: { id, key, width, height, variants }, like posters.
  photo        Json?
  bio          Json
  /// External links (https URLs).
  links        Json
  featured     Boolean         @default(false)
  visibility   Visibility      @default(PUBLIC)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  relations    MediaRelation[]

  @@unique([source, sourceId])
}

enum RelationType {
  SOUNDTRACK @map("soundtrack")
  ADAPTATION @map("adaptation")
  SEQUEL     @map("sequel")
  RELATED    @map("related")
  CREDIT     @map("credit")
}

/// A link between two collection entries, or from a person to an entry. Exactly one of fromMediaId and
/// fromPersonId is set (checked by the database). Stored once and shown on both sides.
model MediaRelation {
  id           String       @id
  fromMediaId  String?
  fromPersonId String?
  toMediaId    String
  type         RelationType
  /// Credits: the person's role (director, actor, ...); soundtracks: opening, ending, insert, ...
  role         String?
  note         Json
  /// One relation per start, end, type and role (related pairs in either direction count as one).
  key          String       @unique
  createdAt    DateTime     @default(now())
  fromMedia    MediaItem?   @relation("RelationFromMedia", fields: [fromMediaId], references: [id], onDelete: Cascade)
  fromPerson   Person?      @relation(fields: [fromPersonId], references: [id], onDelete: Cascade)
  toMedia      MediaItem    @relation("RelationToMedia", fields: [toMediaId], references: [id], onDelete: Cascade)

  @@index([fromMediaId])
  @@index([fromPersonId])
  @@index([toMediaId])
}

/// A playlist of songs: made in the admin, or created by a Spotify import (one per Spotify playlist, and
/// one for Liked Songs).
model Playlist {
  id          String          @id
  name        Json
  description Json
  /// manual or spotify.
  source      String
  /// Spotify playlist id, or "liked" for Liked Songs.
  sourceId    String?
  sourceUrl   String?
  visibility  Visibility      @default(PUBLIC)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tracks      PlaylistTrack[]

  @@unique([source, sourceId])
}

/// A song's place in a playlist.
model PlaylistTrack {
  playlistId String
  mediaId    String
  position   Int
  playlist   Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media      MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([playlistId, mediaId])
  @@index([mediaId])
}

/// A visitor analytics event. Raw events are kept for ANALYTICS_EVENT_RETENTION_DAYS, then only the
/// daily totals in AnalyticsDaily remain. No IP address is stored: `visitor` is a hash with a salt that
/// changes every day.
model AnalyticsEvent {
  id          String   @id
  type        String
  at          DateTime
  /// Local day (YYYY-MM-DD) and hour in ANALYTICS_TIMEZONE.
  day         String
  hour        Int
  sessionId   String
  visitor     String
  path        String
  contentType String?
  contentId   String?
  target      String?
  detail      String?
  value       Float?

  @@index([day])
  @@index([sessionId])
}

/// A visit: everything after 30 minutes without activity is a new session. Holds the details counted
/// once per session (where the visitor came from, country, device).
model AnalyticsSession {
  id          String   @id
  visitor     String
  startedAt   DateTime
  lastSeenAt  DateTime
  day         String
  hour        Int
  entryPath   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  country     String?
  lang        String?
  device      String
  browser     String

  @@index([day])
  @@index([lastSeenAt])
}

/// Daily totals, kept for good: `metric` names a count (views, page, country, ...), `key` what it counts.
model AnalyticsDaily {
  day    String
  metric String
  key    String @default("")
  value  Float

  @@id([day, metric, key])
  @@index([metric, day])
}

/// Days whose totals have been written.
model AnalyticsRollupDay {
  day        String   @id
  computedAt DateTime
}

/// The salt for today's visitor hashes; yesterday's is deleted, so hashes cannot be linked across days.
model AnalyticsSalt {
  day  String @id
  salt String
}

/// The name a piece of content had when last seen, so statistics can still name it after it is
/// hidden or deleted. `key` is "type:id".
model AnalyticsContentName {
  key       String   @id
  type      String
  contentId String
  name      String
  kind      String?
  updatedAt DateTime
}

/// Daily request counts and timings of the public API, by route.
model AnalyticsRequestDaily {
  day          String
  route        String
  requests     Int
  serverErrors Int
  clientErrors Int
  totalMs      Float
  /// Response times: upper bound in ms → count.
  histogram    Json

  @@id([day, route])
}

/// Results of import and sync jobs, and of calls to external sources (TMDB, IGDB, Spotify, ...).
model AnalyticsSystemEvent {
  id      Int      @id @default(autoincrement())
  at      DateTime
  /// job or source.
  kind    String
  name    String
  ok      Boolean
  message String?

  @@index([at])
  @@index([kind, name, at])
}

/// Small analytics flags, e.g. "demo" when the database holds generated demo data.
model AnalyticsFlag {
  key   String @id
  value String
}

/// A group of the home page's tech stack (Frontend, Backend, ...), in the admin's order.
model StackCategory {
  id           String            @id
  /// Per language.
  name         Json
  /// One line per language.
  description  Json
  visible      Boolean           @default(true)
  sortOrder    Int               @default(0)
  technologies StackTechnology[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([sortOrder])
}

/// A technology shown with its logo in a stack category. A category with technologies cannot be
/// deleted (Restrict): the admin moves or deletes them first, explicitly.
model StackTechnology {
  id           String            @id
  categoryId   String
  category     StackCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// As shown, e.g. "React Router"; unique within its category.
  name         String
  iconProvider StackIconProvider @default(NONE)
  /// The icon's key in its library (devicon "react", simpleicons "springboot"); null otherwise.
  iconKey      String?
  /// Uploaded logo: { id, key, width, height, variants: [{ width, height }] }; set with iconProvider CUSTOM.
  customIcon   Json?
  websiteUrl   String?
  prominence   StackProminence   @default(STANDARD)
  visible      Boolean           @default(true)
  /// Position within the category.
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  projects     ProjectTechnology[]

  @@unique([categoryId, name])
  @@index([categoryId, sortOrder])
}

/// A project using a technology of the stack. Deleting either side deletes the link, never the other side.
model ProjectTechnology {
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technologyId String
  technology   StackTechnology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  /// Position in the project's list of technologies.
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())

  @@id([projectId, technologyId])
  @@index([technologyId])
}

enum StackIconProvider {
  NONE        @map("none")
  DEVICON     @map("devicon")
  SIMPLEICONS @map("simpleicons")
  CUSTOM      @map("custom")
}

enum StackProminence {
  PRIMARY  @map("primary")
  STANDARD @map("standard")
}

/// Append-only through the application; protected admin read endpoint exposes no edit/delete API.
model AdminAuditEvent {
 id String @id @default(uuid())
 createdAt DateTime @default(now())
 actor String?
 action String
 method String
 resource String
 status Int
 ip String
 @@index([createdAt, id])
 @@index([action, createdAt])
}

/// The admin account once changed from the server's configured one; a single row.
model AdminCredential {
  id                   String    @id @default("admin")
  username             String
  passwordHash         String
  passwordChangedAt    DateTime?
  /// Sessions signed before this time (seconds) no longer count.
  sessionsNotBefore    Int?
  /// Sealed with a server key.
  totpSecret           String?
  totpPendingSecret    String?
  totpPendingAt        DateTime?
  totpEnabledAt        DateTime?
  totpLastStep         Int?
  /// Keyed hashes of the unused recovery codes.
  recoveryCodes        Json      @default("[]")
  adminPath            String?
  adminPathPending     String?
  adminPathRetiring    String?
  adminPathRetireUntil DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// A sign-in, listed on the security page and revocable from it.
model AdminSession {
  id         String    @id
  createdAt  DateTime
  lastSeenAt DateTime
  expiresAt  DateTime
  ip         String
  userAgent  String
  revokedAt  DateTime?

  @@index([expiresAt])
}

model PersonIdentity {
  id String @id @default(uuid())
  personId String
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  provider String
  externalId String
  confirmed Boolean @default(false)
  @@unique([provider, externalId])
  @@index([personId])
}

model PersonMembership {
  groupId String
  personId String
  role String?
  startYear Int?
  endYear Int?
  group Person @relation("GroupMembers", fields: [groupId], references: [id], onDelete: Cascade)
  person Person @relation("MemberGroups", fields: [personId], references: [id], onDelete: Cascade)
  @@id([groupId, personId])
  @@index([personId])
}

/// One site-hosted image as it is on disk: a folder of generated sizes plus the private original.
/// The register behind duplicate detection, the trash, storage totals and the consistency scan.
model ImageAsset {
  id           String    @id
  /// The folder under UPLOAD_DIR, e.g. "photos/<id>/<imageId>".
  storageKey   String    @unique
  /// photo, project, media, person, branding or stack.
  ownerType    String
  ownerId      String
  /// What the image is to its owner: image, cover, gallery, poster, photo or icon.
  role         String
  /// The uploaded file's name, when there was one.
  originalName String?
  /// The original's extension: jpg, png, webp, avif or tif.
  format       String
  /// Size of the original in bytes.
  bytes        Int
  /// Size of every file in the folder in bytes.
  totalBytes   Int
  width        Int
  height       Int
  /// Generated sizes: [{ "width": 640, "height": 427 }, ...], smallest first.
  variants     Json
  /// SHA-256 of the original, hex; null when the original is missing.
  sha256       String?
  /// The client's id for the upload that created it, so a retried upload is not stored twice.
  uploadId     String?   @unique
  /// ready or trashed.
  status       String    @default("ready")
  trashedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([sha256])
  @@index([ownerType, ownerId])
  @@index([status])
}
