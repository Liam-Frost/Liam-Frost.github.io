generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PUBLIC  @map("public")
  PRIVATE @map("private")
}

/// Where a photo's image files live.
enum ImageStorage {
  /// `src` is an external URL (existing Flickr photos).
  REMOTE_URL @map("remote-url")
  /// Files under UPLOAD_DIR at `storageKey`, served from /uploads.
  LOCAL      @map("local")
}

model Photo {
  id          String       @id
  slug        String       @unique
  title       Json
  date        String
  category    Json
  location    Json?
  camera      String?
  lens        String?
  settings    String?
  description Json?
  tags        Json
  /// External URL for REMOTE_URL photos; empty for uploaded photos (URLs come from storageKey + variants).
  src         String
  storage     ImageStorage @default(REMOTE_URL)
  /// Folder of the uploaded files, e.g. "photos/<id>".
  storageKey  String?
  /// Generated WebP sizes for uploaded photos: [{ "width": 640, "height": 427 }, ...], smallest first.
  variants    Json?
  alt         Json
  width       Int
  height      Int
  featured    Boolean      @default(false)
  visibility  Visibility   @default(PUBLIC)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([visibility, sortOrder])
  @@index([date])
}

enum ProjectStatus {
  IN_PROGRESS @map("in-progress")
  COMPLETED   @map("completed")
  ARCHIVED    @map("archived")
}

model Project {
  id         String        @id
  /// URL segment on the public site (/projects/<slug>); editable, unlike id.
  slug       String        @unique
  title      Json
  /// One-line summary per language.
  summary    Json
  /// Markdown per language.
  body       Json
  /// Uploaded cover image: { id, key, width, height, variants: [{ width, height }] }.
  cover      Json?
  /// Uploaded screenshots, same shape as cover, in display order.
  gallery    Json
  /// Technology names, e.g. ["React", "Fastify"].
  techStack  Json
  /// { repo?, demo?, docs? } URLs.
  links      Json
  status     ProjectStatus @default(IN_PROGRESS)
  /// YYYY-MM
  startedAt  String?
  /// YYYY-MM
  endedAt    String?
  featured   Boolean       @default(false)
  visibility Visibility    @default(PRIVATE)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([visibility, sortOrder])
}

/// Site-wide settings as validated JSON documents, one row per key (e.g. "spotify").
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum MediaKind {
  MOVIE @map("movie")
  TV    @map("tv")
  ANIME @map("anime")
  TRACK @map("track")
  ALBUM @map("album")
  BOOK  @map("book")
  COMIC @map("comic")
  GAME  @map("game")
}

enum MediaStatus {
  WANT     @map("want")
  WATCHING @map("watching")
  DONE     @map("done")
  DROPPED  @map("dropped")
}

/// A collection entry: film, series, anime, or (later) a track or album.
model MediaItem {
  id            String       @id
  kind          MediaKind
  /// tmdb, bangumi, spotify, itunes or manual.
  source        String
  /// The entry's id at the source (TMDB ids are prefixed "movie:" / "tv:").
  sourceId      String?
  sourceUrl     String?
  title         Json
  originalTitle String?
  year          Int?
  /// Localized genre names: [{ "zh": "剧情", "en": "Drama" }, ...]
  genres        Json
  /// Directors, studios, creators.
  credits       Json
  overview      Json
  /// Local poster: { id, key, width, height, variants }, like project covers.
  poster        Json?
  /// Films, series, anime, books, comics and games; null for music.
  status        MediaStatus?
  /// 1-5
  rating        Int?
  review        Json
  /// YYYY-MM-DD
  watchedOn     String?
  rewatchCount  Int          @default(0)
  /// { watched, total }: episodes, a comic's volumes or a book's pages.
  progress      Json?
  /// Kind-specific data; music: { album, durationMs, previewUrl, spotifyUrl, appleUrl };
  /// books and comics: publication: { publisher, pages, volumes, ongoing };
  /// games: game: { platforms, publishers, playtimeHours }.
  extra         Json
  /// Music: plays in the site's player.
  inPlayer      Boolean      @default(false)
  featured      Boolean      @default(false)
  visibility    Visibility   @default(PUBLIC)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  relationsFrom MediaRelation[] @relation("RelationFromMedia")
  relationsTo   MediaRelation[] @relation("RelationToMedia")
  playlists     PlaylistTrack[]

  @@unique([source, sourceId])
  @@index([kind, visibility])
}

/// A person or group linked to collection entries: actors, directors, singers, writers, studios.
model Person {
  id           String          @id
  /// tmdb or manual.
  source       String
  sourceId     String?
  sourceUrl    String?
  name         Json
  originalName String?
  /// Local photo: { id, key, width, height, variants }, like posters.
  photo        Json?
  bio          Json
  /// External links (https URLs).
  links        Json
  featured     Boolean         @default(false)
  visibility   Visibility      @default(PUBLIC)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  relations    MediaRelation[]

  @@unique([source, sourceId])
}

enum RelationType {
  SOUNDTRACK @map("soundtrack")
  ADAPTATION @map("adaptation")
  SEQUEL     @map("sequel")
  RELATED    @map("related")
  CREDIT     @map("credit")
}

/// A link between two collection entries, or from a person to an entry. Exactly one of fromMediaId and
/// fromPersonId is set (checked by the database). Stored once and shown on both sides.
model MediaRelation {
  id           String       @id
  fromMediaId  String?
  fromPersonId String?
  toMediaId    String
  type         RelationType
  /// Credits: the person's role (director, actor, ...); soundtracks: opening, ending, insert, ...
  role         String?
  note         Json
  /// One relation per start, end, type and role (related pairs in either direction count as one).
  key          String       @unique
  createdAt    DateTime     @default(now())
  fromMedia    MediaItem?   @relation("RelationFromMedia", fields: [fromMediaId], references: [id], onDelete: Cascade)
  fromPerson   Person?      @relation(fields: [fromPersonId], references: [id], onDelete: Cascade)
  toMedia      MediaItem    @relation("RelationToMedia", fields: [toMediaId], references: [id], onDelete: Cascade)

  @@index([fromMediaId])
  @@index([fromPersonId])
  @@index([toMediaId])
}

/// A playlist of songs: made in the admin, or created by a Spotify import (one per Spotify playlist, and
/// one for Liked Songs).
model Playlist {
  id          String          @id
  name        Json
  description Json
  /// manual or spotify.
  source      String
  /// Spotify playlist id, or "liked" for Liked Songs.
  sourceId    String?
  sourceUrl   String?
  visibility  Visibility      @default(PUBLIC)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tracks      PlaylistTrack[]

  @@unique([source, sourceId])
}

/// A song's place in a playlist.
model PlaylistTrack {
  playlistId String
  mediaId    String
  position   Int
  playlist   Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media      MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([playlistId, mediaId])
  @@index([mediaId])
}

/// A visitor analytics event. Raw events are kept for ANALYTICS_EVENT_RETENTION_DAYS, then only the
/// daily totals in AnalyticsDaily remain. No IP address is stored: `visitor` is a hash with a salt that
/// changes every day.
model AnalyticsEvent {
  id          String   @id
  type        String
  at          DateTime
  /// Local day (YYYY-MM-DD) and hour in ANALYTICS_TIMEZONE.
  day         String
  hour        Int
  sessionId   String
  visitor     String
  path        String
  contentType String?
  contentId   String?
  target      String?
  detail      String?
  value       Float?

  @@index([day])
  @@index([sessionId])
}

/// A visit: everything after 30 minutes without activity is a new session. Holds the details counted
/// once per session (where the visitor came from, country, device).
model AnalyticsSession {
  id          String   @id
  visitor     String
  startedAt   DateTime
  lastSeenAt  DateTime
  day         String
  hour        Int
  entryPath   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  country     String?
  lang        String?
  device      String
  browser     String

  @@index([day])
  @@index([lastSeenAt])
}

/// Daily totals, kept for good: `metric` names a count (views, page, country, ...), `key` what it counts.
model AnalyticsDaily {
  day    String
  metric String
  key    String @default("")
  value  Float

  @@id([day, metric, key])
  @@index([metric, day])
}

/// Days whose totals have been written.
model AnalyticsRollupDay {
  day        String   @id
  computedAt DateTime
}

/// The salt for today's visitor hashes; yesterday's is deleted, so hashes cannot be linked across days.
model AnalyticsSalt {
  day  String @id
  salt String
}
