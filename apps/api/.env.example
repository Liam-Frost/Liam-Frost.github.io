HOST=0.0.0.0
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# remote-url keeps existing Flickr/image URLs as-is.
# local will resolve image paths under LOCAL_UPLOAD_PUBLIC_BASE_URL.
# r2 will resolve object keys under R2_PUBLIC_BASE_URL.
IMAGE_STORAGE_DRIVER=remote-url
LOCAL_UPLOAD_PUBLIC_BASE_URL=/uploads
R2_PUBLIC_BASE_URL=
