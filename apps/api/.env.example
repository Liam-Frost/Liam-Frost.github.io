HOST=0.0.0.0
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Behind a reverse proxy, list its IPs / CIDR ranges so request.ip comes from X-Forwarded-For.
# "true" trusts any hop: only safe when the API port is reachable through the proxy alone.
TRUST_PROXY=false
DATABASE_URL=postgresql://liam_frost:liam_frost_dev@localhost:5432/liam_frost_site?schema=public

# Admin auth is enabled when ADMIN_PASSWORD_HASH and ADMIN_SESSION_SECRET are both set.
# Generate the hash with: npm run auth:hash -- your-password
ADMIN_USERNAME=liam
ADMIN_PASSWORD_HASH=
# At least 32 characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
# Development only. Use true in production behind HTTPS.
ADMIN_COOKIE_SECURE=false
# Where the admin app is served (default /admin). Changing it only needs a restart.
# Cannot start with /api, /uploads or /assets.
ADMIN_PATH=/admin
# Optional comma-separated IPs / CIDR ranges allowed to reach admin routes; others get a plain 404.
# Empty = no IP restriction. Example: 127.0.0.1,::1,192.168.1.0/24
ADMIN_ALLOWED_IPS=

# Uploaded photos (generated WebP sizes + private originals). Default: apps/api/uploads.
# Files are served from /uploads by the API. Back this directory up together with the database.
UPLOAD_DIR=
# Maximum size of one uploaded image in MB (1-200).
UPLOAD_MAX_MB=40

# Collection searches (movies, series). A TMDB API key (v3) or read access token (v4); empty disables TMDB.
TMDB_API_KEY=

# Spotify developer app for importing your Liked Songs and playlists (set both, or leave both empty).
# Register the redirect URI below in the app; it defaults to http://127.0.0.1:<PORT>/api/admin/spotify/callback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Proxy for outgoing requests (TMDB, Bangumi, Spotify, AniList), when they need one.
# Node does not use the Windows / macOS system proxy; set it here, e.g. http://127.0.0.1:10808
HTTPS_PROXY=
