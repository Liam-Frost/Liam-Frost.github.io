HOST=0.0.0.0
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DATABASE_URL=postgresql://liam_frost:liam_frost_dev@localhost:5432/liam_frost_site?schema=public

# Generate with: npm run auth:hash -- your-password
ADMIN_USERNAME=liam
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
# Development only. Use true in production behind HTTPS.
ADMIN_COOKIE_SECURE=false

# remote-url keeps existing Flickr/image URLs as-is.
# local will resolve image paths under LOCAL_UPLOAD_PUBLIC_BASE_URL.
# r2 will resolve object keys under R2_PUBLIC_BASE_URL.
IMAGE_STORAGE_DRIVER=remote-url
LOCAL_UPLOAD_PUBLIC_BASE_URL=/uploads
R2_PUBLIC_BASE_URL=
