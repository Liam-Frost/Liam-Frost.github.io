# Settings for `docker compose` (copy to .env next to compose.yaml).
# `npm run dev` does not read this file; it uses apps/api/.env.

# Database password (letters and digits only: it is part of DATABASE_URL).
POSTGRES_PASSWORD=liam_frost_dev
# Host port for local database tools and `npm run dev` (loopback only).
POSTGRES_PORT=5432

# Admin login. Generate the hash with:
#   docker compose run --rm --no-deps --entrypoint node app apps/api/dist/hash-password.js "your-password"
# (or `npm run auth:hash -- your-password` outside Docker)
ADMIN_USERNAME=liam
ADMIN_PASSWORD_HASH=
# At least 32 characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
ADMIN_PATH=/admin
ADMIN_ALLOWED_IPS=
# false for plain HTTP (local); true once the site is served over HTTPS.
ADMIN_COOKIE_SECURE=false
UPLOAD_MAX_MB=40

# ":80" = plain HTTP on HTTP_PORT. A domain name (e.g. liamfrost.com) enables automatic HTTPS;
# then use HTTP_PORT=80 and HTTPS_PORT=443.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Private subnet of the compose network; change it only if it clashes with another network.
COMPOSE_SUBNET=172.28.0.0/24

# Collection searches for movies and series (TMDB API key or read access token).
TMDB_API_KEY=
