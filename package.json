{
  "name": "liam-frost-personal-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web,admin -c cyan,magenta,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build -w apps/web && npm run build -w apps/admin && npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:admin": "npm run build -w apps/admin",
    "auth:hash": "npm run auth:hash -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:deploy": "npm run db:deploy -w apps/api",
    "db:push": "npm run db:push -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:seed:collection": "npm run db:seed:collection -w apps/api",
    "db:seed:analytics-demo": "npm run db:seed:analytics-demo -w apps/api",
    "db:backfill:romaji": "npm run db:backfill:romaji -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "preview": "npm run preview -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
